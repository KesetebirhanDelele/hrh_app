{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "country_learning_briefs.schema.json",
  "title": "Country Learning Briefs Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "spec_id", "generated_at", "country", "domains"],
  "properties": {
    "job_id": { "const": "country_learning_briefs" },
    "spec_id": { "$ref": "common.json#/$defs/NonEmptyString" },
    "generated_at": { "$ref": "common.json#/$defs/ISODate" },
    "country": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "common.json#/$defs/NonEmptyString" },
        "iso3": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/DomainBrief" }
    },
    "overall_notes": { "type": "string" }
  },
  "$defs": {
    "DomainBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_id", "domain", "summary", "key_questions", "evidence"],
      "properties": {
        "domain_id": { "$ref": "common.json#/$defs/NonEmptyString" },
        "domain": { "$ref": "common.json#/$defs/NonEmptyString" },
        "summary": { "$ref": "common.json#/$defs/NonEmptyString" },
        "key_questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.json#/$defs/NonEmptyString" }
        },
        "evidence": {
          "oneOf": [
            { "$ref": "common.json#/$defs/EvidenceNote" },
            { "$ref": "common.json#/$defs/NoEvidence" }
          ]
        }
      }
    }
  }
}
