{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase1_discovery_qa.schema.json",
  "title": "Phase 1 Discovery Q&A Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "spec_id", "generated_at", "country", "questions"],
  "properties": {
    "job_id": { "const": "phase1_discovery_qa" },
    "spec_id": { "$ref": "common.json#/$defs/NonEmptyString" },
    "generated_at": { "$ref": "common.json#/$defs/ISODate" },
    "country": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "common.json#/$defs/NonEmptyString" },
        "iso3": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/DiscoveryQuestionAnswer" }
    },
    "notes": {
      "description": "Optional additional notes that are not direct answers.",
      "type": "string"
    }
  },
  "$defs": {
    "DiscoveryQuestionAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "question", "answer", "evidence"],
      "properties": {
        "question_id": { "$ref": "common.json#/$defs/NonEmptyString" },
        "question": { "$ref": "common.json#/$defs/NonEmptyString" },
        "answer": {
          "description": "Answer must be factual; if unknown, say so plainly.",
          "$ref": "common.json#/$defs/NonEmptyString"
        },
        "evidence": {
          "description": "Evidence note with citations. If no support exists, use NoEvidence.",
          "oneOf": [
            { "$ref": "common.json#/$defs/EvidenceNote" },
            { "$ref": "common.json#/$defs/NoEvidence" }
          ]
        },
        "tags": {
          "type": "array",
          "items": { "$ref": "common.json#/$defs/NonEmptyString" },
          "default": []
        }
      }
    }
  }
}
