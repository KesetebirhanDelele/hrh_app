{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain_solutions_from_evidence.schema.json",
  "title": "Domain Solutions from Evidence Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "target_country", "generated_at", "domains"],
  "properties": {
    "job_id":         { "const": "domain_solutions_from_evidence" },
    "target_country": { "$ref": "common.json#/$defs/NonEmptyString" },
    "generated_at":   { "$ref": "common.json#/$defs/ISODate" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Domain" }
    }
  },
  "$defs": {
    "LocalCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id", "locator", "snippet"],
      "properties": {
        "doc_id":        { "$ref": "common.json#/$defs/NonEmptyString" },
        "source_title":  { "$ref": "common.json#/$defs/NonEmptyString" },
        "locator":       { "$ref": "common.json#/$defs/NonEmptyString" },
        "snippet":       { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "Solution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solution_id", "title", "description", "mechanism",
        "implementation_conditions", "evidence_strength", "citations"
      ],
      "properties": {
        "solution_id":               { "$ref": "common.json#/$defs/NonEmptyString" },
        "title":                     { "$ref": "common.json#/$defs/NonEmptyString" },
        "description":               { "$ref": "common.json#/$defs/NonEmptyString" },
        "mechanism":                 { "$ref": "common.json#/$defs/NonEmptyString" },
        "implementation_conditions": {
          "type": "array",
          "items": { "$ref": "common.json#/$defs/NonEmptyString" }
        },
        "evidence_strength": {
          "type": "string",
          "enum": ["strong", "moderate", "weak"]
        },
        "risks": {
          "type": "array",
          "items": { "$ref": "common.json#/$defs/NonEmptyString" }
        },
        "implementation_notes": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/LocalCitation" }
        }
      }
    },
    "FocusArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focus_area_id", "solutions"],
      "properties": {
        "focus_area_id": {
          "type": "string",
          "enum": [
            "supervision_models",
            "performance_contracts",
            "community_or_social_accountability",
            "enforcement_mechanisms",
            "measurement_approaches",
            "incentives_and_sanctions",
            "deployment_housing_safety_workload_factors",
            "task_design_and_task_shifting",
            "time_use_optimization",
            "digital_or_managerial_enablers",
            "governance_arrangements",
            "financing_and_incentives",
            "political_economy_considerations"
          ]
        },
        "solutions": {
          "type": "array",
          "items": { "$ref": "#/$defs/Solution" }
        }
      }
    },
    "Domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_id", "focus_areas"],
      "properties": {
        "domain_id": {
          "type": "string",
          "enum": ["accountability", "absenteeism", "productivity", "system_enablers"]
        },
        "focus_areas": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/FocusArea" }
        }
      }
    }
  }
}
